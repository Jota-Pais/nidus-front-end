# URL base da API do nidus-back-end.
# Desenvolvimento local: http://localhost:3000
# Producao: a URL do servico na Render.
VITE_API_URL=http://localhost:3000

# Rotulo do ambiente, exibido no cabecalho para nao confundir
# desenvolvimento com producao na hora de apresentar.
# Valores aceitos: local | homologacao | producao
VITE_AMBIENTE=local
